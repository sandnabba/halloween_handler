; Copy to platformio.ini (gitignored).
; First upload over USB:  pio run -e usb -t upload
; Later uploads over WiFi: pio run -e ota -t upload  (set upload_port to the portal's IP)

[env]
platform = espressif32
board = esp32dev
framework = arduino
monitor_speed = 115200
lib_deps =
    fastled/FastLED@^3.6.0
    knolleary/PubSubClient@^2.8

[env:usb]
upload_port = /dev/ttyUSB0
monitor_port = /dev/ttyUSB0

[env:ota]
upload_protocol = espota
upload_port = YOUR_ESP32_IP_HERE
; The ESP32 connects back to this port to fetch the firmware, so the
; computer's firewall must let it in from the portal's address
upload_flags = --host_port=3233
